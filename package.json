{
  "name": "promptedsite-cosmic-experience",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3418",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:prepare-preview": "node scripts/prepare-browser-preview.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "lint": "eslint src scripts/media-plugin.ts vite.config.ts",
    "preview": "node scripts/serve.mjs dist 3419",
    "test": "npm run build:artifact && node scripts/run-browser-tests.mjs"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.32.2",
    "gsap": "3.14.2",
    "lottie-web": "^5.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.125.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
